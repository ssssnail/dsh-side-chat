{
  "name": "@local/dsh-side-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Temporary read-only discussion panel (side chat) for the DSH web GUI.",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host/",
    "locale/",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node test/dry-run.mjs && node test/client-render.mjs",
    "test:real": "node test/real-fs.mjs",
    "test:live": "node test/live.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
